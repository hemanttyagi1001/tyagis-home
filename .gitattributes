# Normalise line endings on the way into the repository. Without this an editor
# saving CRLF rewrites whole files, and a one-line change arrives as a diff of
# thousands - which has twice hidden the real change under the noise.
* text=auto eol=lf

# Binary assets, left byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jar binary
