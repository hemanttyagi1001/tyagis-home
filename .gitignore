# Google Play service account key - NEVER commit this.
# No longer used (uploads to Play are manual), but kept so a stray key file
# cannot be committed by accident.
google-service-account.json
*-service-account*.json
play-store-key*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
