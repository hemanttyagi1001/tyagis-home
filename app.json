{
  "expo": {
    "name": "Tyagi's Home",
    "slug": "tyagis-home",
    "owner": "hemanttyagi1001",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A6741"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tyagishome.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A6741"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tyagishome.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-background-fetch",
      "expo-task-manager",
      "expo-font",
      "expo-mail-composer",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Tyagi's Home to save calendar images to your gallery.",
          "photosPermission": "Allow Tyagi's Home to save calendar images to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withScopedStoragePermission"
    ],
    "extra": {
      "eas": {
        "projectId": "cbd2dc2e-16c7-4bd2-bc18-3d7ad76067d0"
      }
    }
  }
}
